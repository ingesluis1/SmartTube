<?xml version="1.0" encoding="utf-8"?>
<!-- MOD (Inge): optieregel als afgeronde balk, wit bij focus (YouTube-stijl) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_window_focused="false">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#FF303030" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#FFF1F1F1" />
            </shape>
        </inset>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
