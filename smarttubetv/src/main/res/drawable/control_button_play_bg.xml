<?xml version="1.0" encoding="utf-8"?>
<!-- MOD (Inge): pauzeknop in rust halfdoorzichtige cirkel, met focus wit (zo is de focus altijd zichtbaar) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F1F1F1" />
            <size android:width="@dimen/lb_control_button_secondary_diameter" android:height="@dimen/lb_control_button_secondary_diameter" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
            <size android:width="@dimen/lb_control_button_secondary_diameter" android:height="@dimen/lb_control_button_secondary_diameter" />
        </shape>
    </item>
</selector>
